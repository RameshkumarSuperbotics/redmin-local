<h2>My Requests</h2>

<table class="list">
  <thead>
    <tr>
      <th>Type</th>
      <th>Subject</th>
      <th>Status</th>
      <th>Created</th>
    </tr>
  </thead>
  <tbody>
    <% @employee_requests.each do |r| %>
      <tr>
        <td><%= link_to r.label, employee_request_path(r) %></td>
        <td><%= r.subject %></td>
        <td><%= r.status %></td>
        <td><%= r.created_at.strftime('%Y-%m-%d %H:%M') %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<p><%= link_to 'Back', employee_requests_path %></p>
