<h2>Daily Meetingss</h2>

<!-- FILTER FORM -->
<%= form_with url: daily_standups_path, method: :get, local: true do %>
  <p>
    <label>User:</label>
    <%= select_tag :user_id,
          options_from_collection_for_select(
            @users,
            :id,
            :name,
            params[:user_id]
          ),
          include_blank: 'All Users'
    %>

    <%= submit_tag 'Filter', class: 'button-small' %>
  </p>
<% end %>

<table class="list">
  <thead>
    <tr>
      <th>Meeting Name</th>
      <th>User</th>
      <th>Date</th>
      <th>Start</th>
      <th>End</th>
      <th>Meeting Time</th>
    </tr>
  </thead>

  <tbody>
    <% @daily_standups.each do |meeting| %>
      <tr>
        <td>
          <%= link_to meeting.name, daily_standup_path(meeting) %>
        </td>
        <td><%= meeting.user.name %></td>
        <td><%= meeting.start_at.to_date %></td>
        <td><%= meeting.start_at.strftime('%H:%M') %></td>
        <td><%= meeting.end_at.strftime('%H:%M') %></td>
        <td><%= meeting.meeting_time %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<p>
  <%= link_to 'New Daily Meeting', new_daily_standup_path, class: 'icon icon-add' %>
</p>
